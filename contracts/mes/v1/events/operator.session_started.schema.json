{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fw.mes.event/1/operator.session_started",
  "title": "An operator logged in at a station",
  "type": "object",
  "required": [
    "operator_name",
    "role",
    "assurance"
  ],
  "properties": {
    "operator_name": {
      "$ref": "#/$defs/operator"
    },
    "role": {
      "$ref": "#/$defs/role"
    },
    "assurance": {
      "$ref": "#/$defs/assurance"
    },
    "reason": {
      "type": "string",
      "maxLength": 64
    }
  },
  "$defs": {
    "operator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "assurance": {
      "enum": [
        "selected_name",
        "role_password",
        "named_account"
      ],
      "description": "How sure we are who the operator is (plan section 16 D4)."
    }
  }
}
