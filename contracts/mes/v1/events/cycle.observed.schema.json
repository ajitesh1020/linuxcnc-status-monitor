{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fw.mes.event/1/cycle.observed",
  "title": "The agent's own view of a run, for cross-checking MillWright",
  "type": "object",
  "required": [
    "started_at",
    "ended_at",
    "outcome",
    "program_path",
    "correlation_method"
  ],
  "properties": {
    "started_at": {
      "$ref": "#/$defs/timestamp"
    },
    "ended_at": {
      "$ref": "#/$defs/timestamp"
    },
    "outcome": {
      "enum": [
        "completed",
        "aborted",
        "unknown"
      ]
    },
    "program_path": {
      "anyOf": [
        {
          "$ref": "#/$defs/path"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlation_method": {
      "enum": [
        "explicit",
        "time_window",
        "none"
      ],
      "description": "How execution_id was found (plan P1.6). Named so it is not confused with the envelope's correlation object."
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    }
  }
}
